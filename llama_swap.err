Usage of C:\Users\khatr\OneDrive\Desktop\indra\SIH-26\hermes-agent\backend\bin\llama-swap.exe:
  -config string
    	path to config file
  -config-dir string
    	directory of *.yml/*.yaml config files (additive to -config)
  -listen string
    	listen address (default :8080 or :8443 for TLS)
  -listen-tailcat string
    	path to Tailcat server PrivateKey JSON file
  -tls-cert-file string
    	TLS certificate file
  -tls-key-file string
    	TLS key file
  -validate
    	validate the config file and exit (without starting the server)
  -version
    	show version and exit
  -watch-config
    	reload config on file change
